/* Gaya utama website Dapur Coklat */
:root {
  --brown: #4b251b;
  --brown-dark: #2d1712;
  --cocoa: #744331;
  --cream: #fff8ef;
  --peach: #f7dfca;
  --pink: #f4c9bd;
  --text: #39251f;
  --muted: #78665f;
  --white: #ffffff;
  --shadow: 0 14px 35px rgba(69, 35, 24, 0.10);
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--text);
  background: var(--white);
  line-height: 1.6;
}
a { color: inherit; text-decoration: none; }
.container { width: min(1100px, calc(100% - 40px)); margin: 0 auto; }

.site-header {
  background: var(--cream);
  border-bottom: 1px solid #f0e4d8;
}
.navbar {
  min-height: 76px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}
.brand {
  color: var(--brown);
  font-size: 1.35rem;
  font-weight: 800;
  letter-spacing: -0.5px;
}
.brand-icon { margin-right: 7px; }
.nav-links { display: flex; gap: 26px; color: var(--cocoa); font-size: 0.95rem; font-weight: 700; }
.nav-links a:hover { color: #b45e42; }

.hero {
  position: relative;
  overflow: hidden;
  min-height: 430px;
  display: flex;
  align-items: center;
  background: linear-gradient(115deg, #fff3e7 0%, #f5d8c7 62%, #edc1b0 100%);
}
.hero-content { position: relative; z-index: 1; padding-top: 65px; padding-bottom: 70px; }
.eyebrow {
  margin: 0 0 10px;
  color: #a65a40;
  text-transform: uppercase;
  letter-spacing: 2px;
  font-size: 0.75rem;
  font-weight: 800;
}
h1, h2, h3, p { margin-top: 0; }
.hero h1 {
  max-width: 620px;
  margin-bottom: 16px;
  color: var(--brown-dark);
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(2.8rem, 7vw, 5rem);
  line-height: 1.05;
}
.hero h1 span { color: #a95338; }
.hero-description { max-width: 520px; margin-bottom: 27px; color: #684d42; font-size: 1.08rem; }
.hero-decoration {
  position: absolute;
  right: max(7%, calc((100% - 1100px) / 2));
  top: 50%;
  transform: translateY(-50%) rotate(-9deg);
  display: grid;
  place-items: center;
  width: 245px;
  height: 245px;
  border: 2px dashed rgba(117, 66, 48, 0.25);
  border-radius: 50%;
  background: rgba(255,255,255,0.28);
  font-size: 8rem;
}

.button {
  display: inline-block;
  padding: 12px 23px;
  border-radius: 999px;
  font-weight: 800;
  transition: transform 0.2s ease, background 0.2s ease;
}
.button:hover { transform: translateY(-2px); }
.button-primary { color: var(--white); background: var(--brown); }
.button-primary:hover { background: #6a3828; }

.section { padding-top: 76px; padding-bottom: 76px; }
.section-heading { max-width: 620px; margin: 0 auto 35px; text-align: center; }
.section-heading h2, .about-content h2, .contact-section h2 {
  margin-bottom: 10px;
  color: var(--brown);
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(2rem, 4vw, 2.7rem);
}
.section-heading > p:last-child { color: var(--muted); }
.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; }
.product-card {
  overflow: hidden;
  border: 1px solid #f0e5dc;
  border-radius: 20px;
  background: var(--white);
  box-shadow: var(--shadow);
}
.product-art {
  min-height: 180px;
  display: grid;
  place-items: center;
  font-size: 5.2rem;
}
.cake-art { background: #f8e4d5; }
.cupcake-art { background: #f7e1e4; }
.cookies-art { background: #f3e7ce; }
.product-info { padding: 22px; }
.product-info h3 { margin-bottom: 7px; color: var(--brown); font-size: 1.2rem; }
.product-info p { min-height: 52px; margin-bottom: 14px; color: var(--muted); font-size: 0.95rem; }
.product-tag {
  display: inline-block;
  padding: 5px 10px;
  border-radius: 999px;
  color: #8a4b35;
  background: #fff0e5;
  font-size: 0.75rem;
  font-weight: 800;
}
.note { margin: 22px 0 0; color: var(--muted); font-size: 0.82rem; text-align: center; }

.about-section { padding: 65px 0; background: var(--cream); }
.about-content { display: grid; grid-template-columns: 150px 1fr; align-items: center; gap: 35px; max-width: 850px; }
.about-icon {
  display: grid;
  place-items: center;
  width: 140px;
  height: 140px;
  border-radius: 50%;
  background: var(--peach);
  font-size: 4.2rem;
}
.about-content p:last-child { margin-bottom: 0; color: var(--muted); }
.contact-section { text-align: center; }
.contact-section > p:not(.eyebrow) { max-width: 600px; margin: 0 auto 22px; color: var(--muted); }
.contact-placeholder {
  display: inline-flex;
  flex-direction: column;
  gap: 4px;
  max-width: 550px;
  padding: 17px 24px;
  border: 1px dashed #d5b5a3;
  border-radius: 14px;
  background: var(--cream);
  color: var(--brown);
}
.contact-placeholder span { color: var(--muted); font-size: 0.9rem; }

.site-footer { padding: 22px 0; color: #f9eee7; background: var(--brown-dark); font-size: 0.88rem; }
.footer-content { display: flex; justify-content: space-between; gap: 15px; }

.error-page {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
  background: linear-gradient(135deg, #fff5eb, #f0d0bf);
}
.error-card {
  width: min(560px, 100%);
  padding: 48px 30px;
  border: 1px solid #f0dfd2;
  border-radius: 25px;
  background: var(--white);
  box-shadow: var(--shadow);
  text-align: center;
}
.error-illustration { margin-bottom: 12px; font-size: 4rem; }
.error-card h1 { margin: 0; color: #a95338; font-size: 5rem; line-height: 1; }
.error-card h2 { margin: 10px 0; color: var(--brown); font-family: Georgia, 'Times New Roman', serif; font-size: 1.7rem; }
.error-card > p:not(.eyebrow) { color: var(--muted); }
.error-help { margin: 24px 0 0; font-size: 0.82rem; }

@media (max-width: 760px) {
  .navbar { padding-top: 17px; padding-bottom: 17px; align-items: flex-start; flex-direction: column; gap: 12px; }
  .nav-links { width: 100%; flex-wrap: wrap; gap: 10px 19px; font-size: 0.88rem; }
  .hero { min-height: 390px; }
  .hero-content { padding-top: 55px; padding-bottom: 55px; }
  .hero-decoration { right: -55px; top: auto; bottom: -70px; transform: none; width: 190px; height: 190px; font-size: 6rem; opacity: 0.45; }
  .product-grid { grid-template-columns: 1fr; max-width: 430px; margin: 0 auto; }
  .product-info p { min-height: auto; }
  .about-content { grid-template-columns: 1fr; gap: 20px; text-align: center; }
  .about-icon { width: 110px; height: 110px; margin: 0 auto; font-size: 3.3rem; }
  .footer-content { flex-direction: column; text-align: center; }
}

